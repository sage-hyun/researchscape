{
  "name": "researchscape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:demo": "node scripts/demo.mjs",
    "git:setup": "node scripts/setup-git.mjs",
    "git:check": "node scripts/check-tracked-files.mjs --all",
    "index": "node server.mjs --index",
    "bibliography:diagnose": "node scripts/diagnose-bibliography.mjs",
    "figures:setup": "node scripts/setup-figures.mjs",
    "figures:scan": "node scripts/figures.mjs --scan",
    "figures:local": "node scripts/figures.mjs",
    "figures:acquire": "node scripts/figures.mjs --acquire",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-source.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
